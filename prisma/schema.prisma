generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Customers who sign up for product updates (name, email, credit score)
model ProductUpdateLead {
  id          String    @id @default(cuid())
  name        String
  email       String
  creditScore Int?      // 300-850, optional
  createdAt   DateTime  @default(now())
}

